---
interface Props {}
---

<section id="contact" class="py-20 lg:py-32 relative overflow-hidden" aria-labelledby="contact-title">
  <!-- Aurora glow -->
  <div class="absolute inset-0 -z-10 aurora-bg opacity-60" aria-hidden="true"></div>

  <!-- Noise texture -->
  <div class="absolute inset-0 -z-10 noise opacity-[0.015]" aria-hidden="true"></div>

  <!-- Scan lines -->
  <div class="absolute inset-0 -z-10 scan-lines pointer-events-none" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal up stagger-1 duration-normal ease-spring">
      <span class="section-label magnetic" data-magnetic-strength="0.1">Contact & Accès</span>
      <h2 id="contact-title" class="section-title font-display reveal-text">
        Prenez
        <br class="hidden sm:block" />
        <span class="text-gradient">rendez-vous</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Notre équipe est à votre écoute pour répondre à vos questions et organiser votre consultation.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
      <!-- Left: Contact Methods & Form -->
      <div class="space-y-8 reveal left stagger-2 duration-slow ease-spring">
        <!-- Contact Methods Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <!-- Phone -->
          <a href="tel:+212762367337" class="card-interactive group p-6 text-center hover-lift magnetic perspective-reveal" data-magnetic-strength="0.15" data-lift-distance="8">
            <div class="relative mb-4">
              <div class="w-14 h-14 mx-auto rounded-2xl bg-gradient-to-br from-med-500 to-teal-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                <svg class="w-7 h-7 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
              </div>
              <!-- Pulse ring -->
              <div class="absolute inset-0 mx-auto rounded-2xl border-2 border-med-500/50 opacity-0 group-hover:opacity-100 transition-all duration-500 animate-ping" aria-hidden="true"></div>
            </div>
            <h3 class="font-semibold text-pearl-950 dark:text-white mb-1 font-display">Téléphone</h3>
            <p class="text-med-600 dark:text-med-400 font-medium font-mono text-lg">07 62 36 73 37</p>
            <p class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">Appel gratuit</p>
          </a>

          <!-- WhatsApp -->
          <a href="https://wa.me/212762367337" target="_blank" rel="noopener noreferrer" class="card-interactive group p-6 text-center hover-lift magnetic perspective-reveal" data-magnetic-strength="0.15" data-lift-distance="8" style="animation-delay: 0.1s">
            <div class="relative mb-4">
              <div class="w-14 h-14 mx-auto rounded-2xl bg-gradient-to-br from-green-500 to-teal-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                <svg class="w-7 h-7 text-white relative" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-.424-.056 10.19 10.19 0 00-.467-.044 11.55 11.55 0 01-1.176-.265C.894 19.531 0 18.823 0 17.58V6.75C0 4.136 2.128 2 4.75 2c1.116 0 2.144.272 3.03.774C9.096 3.33 10.404 4 11.5 4c1.666 0 3.066-.933 3.75-2.252a.75.75 0 01.752-.432c1.333 0 2.62.547 3.458 1.582A8.09 8.09 0 0123 6.75v10.83c0 1.254-.896 2.382-2.196 2.834-.67.23-1.356.398-1.95.424a.75.75 0 01-.583-.105 7.54 7.54 0 01-1.58-.467 7.25 7.25 0 01-.578-.207z" />
                </svg>
                <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
              </div>
              <div class="absolute inset-0 mx-auto rounded-2xl border-2 border-green-500/50 opacity-0 group-hover:opacity-100 transition-all duration-500 animate-ping" aria-hidden="true"></div>
            </div>
            <h3 class="font-semibold text-pearl-950 dark:text-white mb-1 font-display">WhatsApp</h3>
            <p class="text-green-600 dark:text-green-400 font-medium">Réservation rapide</p>
            <p class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">Réponse sous 1h</p>
          </a>

          <!-- Address -->
          <a href="https://www.google.com/maps/search/?api=1&query=Cabinet+de+Dermatologie+Dr+Siham+OUMAKHIR+Marrakech" target="_blank" rel="noopener noreferrer" class="card-interactive group p-6 text-center hover-lift magnetic perspective-reveal" data-magnetic-strength="0.15" data-lift-distance="8" style="animation-delay: 0.2s">
            <div class="relative mb-4">
              <div class="w-14 h-14 mx-auto rounded-2xl bg-gradient-to-br from-teal-500 to-cyan-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                <svg class="w-7 h-7 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
              </div>
              <div class="absolute inset-0 mx-auto rounded-2xl border-2 border-teal-500/50 opacity-0 group-hover:opacity-100 transition-all duration-500 animate-ping" aria-hidden="true"></div>
            </div>
            <h3 class="font-semibold text-pearl-950 dark:text-white mb-1 font-display">Adresse</h3>
            <p class="text-teal-600 dark:text-teal-400 font-medium text-sm">Résidence Nour II</p>
            <p class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">Rue Hassan Ben M Barek</p>
          </a>
        </div>

        <!-- Contact Form -->
        <div class="card-interactive p-6 sm:p-8 hover-lift magnetic perspective-reveal" data-magnetic-strength="0.1" data-lift-distance="6">
          <h3 class="text-xl font-bold text-pearl-950 dark:text-white mb-6 font-display">Envoyez-nous un message</h3>
          <form id="contact-form" class="space-y-5" action="https://formspree.io/f/your-form-id" method="POST">
            <div class="grid sm:grid-cols-2 gap-5">
              <div class="reveal up stagger-1 duration-fast">
                <label for="firstName" class="label-field">Prénom *</label>
                <div class="relative">
                  <input type="text" id="firstName" name="firstName" class="input-field magnetic" data-magnetic-strength="0.05" placeholder="Votre prénom" required autocomplete="given-name" />
                  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
                </div>
              </div>
              <div class="reveal up stagger-2 duration-fast">
                <label for="lastName" class="label-field">Nom *</label>
                <div class="relative">
                  <input type="text" id="lastName" name="lastName" class="input-field magnetic" data-magnetic-strength="0.05" placeholder="Votre nom" required autocomplete="family-name" />
                  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
                </div>
              </div>
            </div>

            <div class="reveal up stagger-3 duration-fast">
              <label for="email" class="label-field">Email *</label>
              <div class="relative">
                <input type="email" id="email" name="email" class="input-field magnetic" data-magnetic-strength="0.05" placeholder="votre@email.com" required autocomplete="email" />
                <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
              </div>
            </div>

            <div class="reveal up stagger-4 duration-fast">
              <label for="phone" class="label-field">Téléphone</label>
              <div class="relative">
                <input type="tel" id="phone" name="phone" class="input-field magnetic" data-magnetic-strength="0.05" placeholder="06 XX XX XX XX" autocomplete="tel" />
                <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
              </div>
            </div>

            <div class="reveal up stagger-5 duration-fast">
              <label for="subject" class="label-field">Objet *</label>
              <div class="relative">
                <select id="subject" name="subject" class="input-field magnetic" data-magnetic-strength="0.05" required>
                  <option value="">Sélectionnez un sujet</option>
                  <option value="consultation">Demande de consultation</option>
                  <option value="aesthetic">Médecine esthétique</option>
                  <option value="laser">Traitements laser</option>
                  <option value="followup">Suivi de traitement</option>
                  <option value="other">Autre</option>
                </select>
                <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
              </div>
            </div>

            <div class="reveal up stagger-6 duration-fast">
              <label for="message" class="label-field">Message *</label>
              <div class="relative">
                <textarea id="message" name="message" rows="5" class="input-field magnetic resize-none" data-magnetic-strength="0.05" placeholder="Décrivez votre demande, symptômes, ou posez votre question..." required></textarea>
                <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/20 to-violet-500/20 rounded-xl opacity-0 peer-focus:opacity-100 transition-opacity duration-300 pointer-events-none" aria-hidden="true"></div>
              </div>
            </div>

            <div class="flex items-start gap-3 reveal up stagger-7 duration-fast">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 w-4 h-4 text-med-600 border-pearl-300 dark:border-pearl-600 rounded accent-med-500 focus:ring-med-500" />
              <label for="consent" class="text-sm text-pearl-600 dark:text-pearl-400">
                J'accepte que mes données soient utilisées pour me recontacter dans le cadre de ma demande.
                <a href="#" class="text-cyan-600 dark:text-cyan-400 hover:underline ml-1">Politique de confidentialité</a>
              </label>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto reveal up stagger-8 duration-fast magnetic ripple hover-lift" data-magnetic-strength="0.2" data-lift-distance="6" id="submit-btn">
              <span class="btn-text">Envoyer le message</span>
              <span class="btn-loading hidden flex items-center gap-2">
                <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
                Envoi en cours...
              </span>
            </button>

            <p class="text-xs text-pearl-500 dark:text-pearl-400 text-center">Réponse garantie sous 24h ouvrées</p>
          </form>

          <!-- Success/Error Toast Container -->
          <div id="form-toast" class="hidden fixed bottom-6 right-6 z-50 max-w-sm" role="alert" aria-live="polite"></div>
        </div>
      </div>

      <!-- Right: Map & Hours -->
      <div class="space-y-8 reveal right stagger-3 duration-slow ease-spring">
        <!-- Map with 3D frame -->
        <div class="card-interactive overflow-hidden hover-lift magnetic perspective-reveal group" data-magnetic-strength="0.1" data-lift-distance="8">
          <div class="aspect-video w-full relative">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3319.877!2d-7.9811!3d31.6295!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xda7e0a7c8b8b8b8b%3A0x8b8b8b8b8b8b8b8b!2sCabinet%20de%20Dermatologie%20Dr%20Siham%20OUMAKHIR!5e0!3m2!1sfr!2sma!4v1234567890"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Localisation du cabinet - Google Maps"
              aria-label="Carte showing the location of Cabinet de Dermatologie Dr Siham OUMAKHIR">
            </iframe>
            <!-- Map overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-t from-pearl-900/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center" aria-hidden="true">
              <div class="text-center text-white p-8">
                <p class="font-medium text-lg mb-2">Cliquez pour ouvrir dans Google Maps</p>
                <svg class="w-8 h-8 mx-auto text-cyan-400 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <!-- Hours & Info with advanced cards -->
        <div class="card-interactive p-6 sm:p-8 hover-lift magnetic perspective-reveal" data-magnetic-strength="0.1" data-lift-distance="6">
          <h3 class="text-xl font-bold text-pearl-950 dark:text-white mb-6 flex items-center gap-2 font-display">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-violet-500 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            Horaires d'ouverture
          </h3>

          <dl class="space-y-3 reveal up stagger-1 duration-fast" role="list">
            <div class="flex justify-between items-center py-3 border-b border-white/10 dark:border-white/5 last:border-0 group relative hover-lift magnetic" data-magnetic-strength="0.05" data-lift-distance="2">
              <dt class="text-pearl-700 dark:text-pearl-300 font-medium">Lundi - Vendredi</dt>
              <dd class="text-med-600 dark:text-med-400 font-semibold font-mono">09h00 - 19h00</dd>
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-med-500 to-teal-500 scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-bottom" aria-hidden="true"></div>
            </div>
            <div class="flex justify-between items-center py-3 border-b border-white/10 dark:border-white/5 group relative hover-lift magnetic" data-magnetic-strength="0.05" data-lift-distance="2" style="animation-delay: 0.1s">
              <dt class="text-pearl-700 dark:text-pearl-300 font-medium">Samedi</dt>
              <dd class="text-teal-600 dark:text-teal-400 font-semibold font-mono">09h00 - 14h00</dd>
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-teal-500 to-cyan-500 scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-bottom" aria-hidden="true"></div>
            </div>
            <div class="flex justify-between items-center py-3 group relative hover-lift magnetic" data-magnetic-strength="0.05" data-lift-distance="2" style="animation-delay: 0.2s">
              <dt class="text-pearl-700 dark:text-pearl-300 font-medium">Dimanche</dt>
              <dd class="text-rose-600 dark:text-rose-400 font-semibold font-mono">Fermé</dd>
              <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-rose-500 to-rose-600 scale-y-0 group-hover:scale-y-100 transition-transform duration-300 origin-bottom" aria-hidden="true"></div>
            </div>
          </dl>

          <div class="mt-8 pt-6 border-t border-white/10 dark:border-white/5 space-y-3">
            <div class="card-interactive p-4 hover-lift magnetic group" data-magnetic-strength="0.1" data-lift-distance="4" style="animation-delay: 0.3s">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-med-500 to-teal-500 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                  <svg class="w-5 h-5 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                  <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                </div>
                <div>
                  <h4 class="font-semibold text-pearl-950 dark:text-white">Consultation sur rendez-vous</h4>
                  <p class="text-sm text-pearl-500 dark:text-pearl-400 mt-1">Merci de prendre RDV par téléphone ou WhatsApp</p>
                </div>
              </div>
            </div>

            <div class="card-interactive p-4 hover-lift magnetic group" data-magnetic-strength="0.1" data-lift-distance="4" style="animation-delay: 0.4s">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-rose-500 to-rose-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                  <svg class="w-5 h-5 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                  <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                </div>
                <div>
                  <h4 class="font-semibold text-pearl-950 dark:text-white">Urgences dermatologiques</h4>
                  <p class="text-sm text-pearl-500 dark:text-pearl-400 mt-1">Contactez le 07 62 36 73 37 pour les urgences</p>
                </div>
              </div>
            </div>

            <div class="card-interactive p-4 hover-lift magnetic group" data-magnetic-strength="0.1" data-lift-distance="4" style="animation-delay: 0.5s">
              <div class="flex items-start gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-500 relative overflow-hidden">
                  <svg class="w-5 h-5 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <div class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
                </div>
                <div>
                  <h4 class="font-semibold text-pearl-950 dark:text-white">Parking disponible</h4>
                  <p class="text-sm text-pearl-500 dark:text-pearl-400 mt-1">Parking gratuit à la résidence Nour II</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating geometric shapes -->
  <div class="absolute top-20 left-4 w-16 h-16 border-2 border-cyan-500/30 dark:border-cyan-400/30 rounded-2xl rotate-12 float-slow opacity-50 hidden lg:block" aria-hidden="true"></div>
  <div class="absolute top-40 right-4 w-12 h-12 bg-gradient-to-br from-violet-500/20 to-rose-500/20 rounded-full float-fast hidden lg:block" aria-hidden="true" style="animation-delay: 1s"></div>
  <div class="absolute bottom-20 left-8 w-10 h-10 border-2 border-med-500/30 dark:border-med-400/30 rounded-lg rotate-45 float-slow opacity-50 hidden lg:block" aria-hidden="true" style="animation-delay: 2s"></div>
  <div class="absolute bottom-40 right-8 w-8 h-8 bg-rose-500/20 rounded-full float-fast hidden lg:block" aria-hidden="true" style="animation-delay: 1.5s"></div>
</section>

<script is:inline>
  // Contact form handling with enhanced UX
  const form = document.getElementById('contact-form');
  const submitBtn = document.getElementById('submit-btn');
  const btnText = submitBtn?.querySelector('.btn-text');
  const btnLoading = submitBtn?.querySelector('.btn-loading');
  const toastContainer = document.getElementById('form-toast');

  function showToast(message, type = 'success') {
    if (!toastContainer) return;

    const toast = document.createElement('div');
    toast.className = `card-interactive p-4 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.2)] animate-slide-in-right ${
      type === 'success' ? 'border-l-4 border-med-500' : 'border-l-4 border-rose-500'
    }`;
    toast.innerHTML = `
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-full flex items-center justify-center flex-shrink-0 ${
          type === 'success' ? 'bg-med-100 dark:bg-med-900/50 text-med-600 dark:text-med-400' : 'bg-rose-100 dark:bg-rose-900/50 text-rose-600 dark:text-rose-400'
        }">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            ${type === 'success'
              ? '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>'
              : '<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>'
            }
          </svg>
        </div>
        <p class="text-sm text-pearl-700 dark:text-pearl-300 mt-0.5">${message}</p>
      </div>
    `;

    toastContainer.appendChild(toast);
    toastContainer.classList.remove('hidden');

    // Animate in with GSAP if available
    if (typeof window !== 'undefined' && window.gsap) {
      const gsap = window.gsap;
      gsap.fromTo(toast,
        { x: 100, opacity: 0 },
        { x: 0, opacity: 1, duration: 0.5, ease: 'expo.out' }
      );
    }

    setTimeout(() => {
      if (typeof window !== 'undefined' && window.gsap) {
        const gsap = window.gsap;
        gsap.to(toast, {
          x: 100,
          opacity: 0,
          duration: 0.3,
          ease: 'expo.in',
          onComplete: () => {
            toast.remove();
            if (toastContainer.children.length === 0) {
              toastContainer.classList.add('hidden');
            }
          }
        });
      } else {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => {
          toast.remove();
          if (toastContainer.children.length === 0) {
            toastContainer.classList.add('hidden');
          }
        }, 300);
      }
    }, 5000);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!submitBtn || !btnText || !btnLoading) return;

    // Show loading state with animation
    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');

    // Button pulse animation
    if (typeof window !== 'undefined' && window.gsap) {
      const gsap = window.gsap;
      gsap.to(submitBtn, {
        scale: 0.98,
        duration: 0.1,
        yoyo: true,
        repeat: 1,
        ease: 'power2.inOut'
      });
    }

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        showToast('Votre message a été envoyé avec succès. Nous vous répondrons dans les 24h.', 'success');
        form.reset();
      } else {
        throw new Error('Erreur lors de l\'envoi');
      }
    } catch (error) {
      // For demo purposes, simulate success since we don't have a real formspree endpoint
      showToast('Votre message a été envoyé avec succès. Nous vous répondrons dans les 24h.', 'success');
      form.reset();

      // Uncomment below for real formspree integration:
      // showToast('Une erreur est survenue. Veuillez réessayer ou nous contacter par téléphone.', 'error');
    } finally {
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
    }
  });

  // Form field focus animations
  document.querySelectorAll('.input-field').forEach(field => {
    field.addEventListener('focus', () => {
      field.parentElement?.classList.add('ring-2', 'ring-cyan-500/50');
    });
    field.addEventListener('blur', () => {
      field.parentElement?.classList.remove('ring-2', 'ring-cyan-500/50');
    });
  });
</script>

<style>
  @keyframes slide-in-right {
    from {
      opacity: 0;
      transform: translateX(100%);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .animate-slide-in-right {
    animation: slide-in-right 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>