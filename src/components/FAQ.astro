<script is:inline>
  // FAQ Accordion with GSAP animations
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const faqItem = trigger.closest('[data-faq]');
      const content = faqItem?.querySelector('.faq-content');
      const icon = trigger.querySelector('svg');
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';

      if (!content || !icon) return;

      // Close all other FAQ items
      document.querySelectorAll('.faq-trigger').forEach(otherTrigger => {
        if (otherTrigger !== trigger) {
          otherTrigger.setAttribute('aria-expanded', 'false');
          const otherContent = otherTrigger.closest('[data-faq]')?.querySelector('.faq-content');
          const otherIcon = otherTrigger.querySelector('svg');
          const otherItem = otherTrigger.closest('[data-faq]');
          const otherAccent = otherItem?.querySelector('[aria-hidden="true"].absolute');

          if (otherContent) {
            if (typeof window !== 'undefined' && window.gsap) {
              const gsap = window.gsap;
              gsap.to(otherContent, {
                height: 0,
                opacity: 0,
                duration: 0.4,
                ease: 'expo.inOut',
                onComplete: () => otherContent.classList.add('hidden')
              });
            } else {
              otherContent.classList.add('hidden');
            }
          }
          otherIcon?.classList.remove('rotate-180');
          if (otherAccent) otherAccent.classList.remove('group-aria-expanded:scale-x-100');
        }
      });

      // Toggle current
      trigger.setAttribute('aria-expanded', (!isExpanded).toString());
      icon.classList.toggle('rotate-180', !isExpanded);

      if (!isExpanded) {
        content.classList.remove('hidden');
        if (typeof window !== 'undefined' && window.gsap) {
          const gsap = window.gsap;
          gsap.fromTo(content,
            { height: 0, opacity: 0 },
            { height: 'auto', opacity: 1, duration: 0.6, ease: 'expo.out' }
          );
        }
      } else {
        if (typeof window !== 'undefined' && window.gsap) {
          const gsap = window.gsap;
          gsap.to(content, {
            height: 0,
            opacity: 0,
            duration: 0.4,
            ease: 'expo.inOut',
            onComplete: () => content.classList.add('hidden')
          });
        } else {
          content.classList.add('hidden');
        }
      }
    });

    // Keyboard support
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        trigger.click();
      }
    });
  });
</script>