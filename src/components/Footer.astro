<script is:inline>
  // Back to top button
  const backToTop = document.getElementById('back-to-top');

  if (backToTop) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTop.classList.remove('opacity-0', 'invisible', 'translate-y-4');
        backToTop.classList.add('opacity-100', 'visible', 'translate-y-0');
      } else {
        backToTop.classList.add('opacity-0', 'invisible', 'translate-y-4');
        backToTop.classList.remove('opacity-100', 'visible', 'translate-y-0');
      }
    }, { passive: true });

    backToTop.addEventListener('click', () => {
      if (typeof window !== 'undefined' && window.lenis) {
        window.lenis.scrollTo(0, { duration: 1.5, easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)) });
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  }

  // Footer link hover effects
  document.querySelectorAll('.footer-link').forEach(link => {
    link.addEventListener('mouseenter', () => {
      if (typeof window !== 'undefined' && window.gsap) {
        const gsap = window.gsap;
        gsap.to(link, { x: 4, duration: 0.3, ease: 'expo.out' });
      }
    });
    link.addEventListener('mouseleave', () => {
      if (typeof window !== 'undefined' && window.gsap) {
        const gsap = window.gsap;
        gsap.to(link, { x: 0, duration: 0.3, ease: 'expo.out' });
      }
    });
  });
</script>

<style>
  .footer-link {
    position: relative;
    display: inline-block;
  }

  .footer-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    border-radius: 9999px;
    transition: all 0.3s ease;
  }

  .footer-link:hover::after {
    width: 100%;
  }

  /* Color variants for footer links */
  .footer-link:hover.text-cyan-500::after { background-color: #06b6d4; }
  .footer-link:hover.text-teal-500::after { background-color: #14b8a6; }
  .footer-link:hover.text-rose-500::after { background-color: #f43f5e; }
  .footer-link:hover.text-amber-500::after { background-color: #f59e0b; }
  .footer-link:hover.text-med-500::after { background-color: #22c55e; }
  .footer-link:hover.text-indigo-500::after { background-color: #6366f1; }
  .footer-link:hover.text-purple-500::after { background-color: #a855f7; }
</style>