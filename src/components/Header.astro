---
interface Props {
  currentPage?: string;
}
const { currentPage = 'home' } = Astro.props;
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-500" id="main-header">
  <!-- Header background with glass effect -->
  <div class="absolute inset-0 bg-white/80 dark:bg-pearl-950/80 backdrop-blur-2xl border-b border-white/20 dark:border-white/10" aria-hidden="true"></div>
  <!-- Gradient accent line -->
  <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-gradient-to-r from-cyan-500 via-violet-500 to-rose-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>

  <nav class="section-container relative" aria-label="Navigation principale">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo with magnetic effect -->
      <a href="/" class="flex items-center gap-3 magnetic hover-lift" data-magnetic-strength="0.2" data-lift-distance="4" aria-label="Cabinet de Dermatologie Dr Siham OUMAKHIR - Accueil">
        <div class="relative w-11 h-11 rounded-2xl flex items-center justify-center group relative overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 via-violet-500 to-rose-500" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-gradient-to-br from-cyan-500 via-violet-500 to-rose-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true"></div>
          <svg class="w-6 h-6 text-white relative" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
          <!-- Pulse ring -->
          <div class="absolute inset-0 rounded-2xl border-2 border-cyan-500/50 opacity-0 group-hover:opacity-100 transition-all duration-500 animate-ping" aria-hidden="true"></div>
        </div>
        <div class="hidden sm:block">
          <span class="text-xl font-bold text-pearl-950 dark:text-white font-display">Dr Siham OUMAKHIR</span>
          <p class="text-xs text-pearl-500 dark:text-pearl-400 font-medium">Dermatologue - Médecine Esthétique</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="#services" class="nav-link relative px-4 py-2.5 text-sm font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic" data-magnetic-strength="0.15" aria-current={currentPage === 'services' ? 'page' : undefined}>
          Nos Services
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-cyan-500 to-violet-500 rounded-full transition-all duration-300 group-hover:w-full" aria-hidden="true"></span>
        </a>
        <a href="#about" class="nav-link relative px-4 py-2.5 text-sm font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic" data-magnetic-strength="0.15" aria-current={currentPage === 'about' ? 'page' : undefined}>
          Le Cabinet
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-teal-500 to-cyan-500 rounded-full transition-all duration-300 group-hover:w-full" aria-hidden="true"></span>
        </a>
        <a href="#reviews" class="nav-link relative px-4 py-2.5 text-sm font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic" data-magnetic-strength="0.15" aria-current={currentPage === 'reviews' ? 'page' : undefined}>
          Avis Patients
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-rose-500 to-rose-600 rounded-full transition-all duration-300 group-hover:w-full" aria-hidden="true"></span>
        </a>
        <a href="#faq" class="nav-link relative px-4 py-2.5 text-sm font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic" data-magnetic-strength="0.15" aria-current={currentPage === 'faq' ? 'page' : undefined}>
          FAQ
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-amber-500 to-orange-500 rounded-full transition-all duration-300 group-hover:w-full" aria-hidden="true"></span>
        </a>
        <a href="#contact" class="nav-link relative px-4 py-2.5 text-sm font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic" data-magnetic-strength="0.15" aria-current={currentPage === 'contact' ? 'page' : undefined}>
          Contact
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-gradient-to-r from-med-500 to-teal-500 rounded-full transition-all duration-300 group-hover:w-full" aria-hidden="true"></span>
        </a>
      </div>

      <!-- CTA Buttons & Theme Toggle -->
      <div class="flex items-center gap-3">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2.5 rounded-xl glass-strong text-pearl-600 dark:text-pearl-400 hover:text-pearl-950 dark:hover:text-white hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.15)] transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.25" data-lift-distance="4" aria-label="Basculer le thème" aria-pressed="false" style="color: var(--text-secondary);">
          <span id="theme-icon">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </span>
        </button>

        <!-- Phone -->
        <a href="tel:+212762367337" class="hidden sm:flex items-center gap-2 px-4 py-2.5 text-sm font-medium text-pearl-700 dark:text-pearl-300 glass-strong rounded-xl hover:text-med-600 dark:hover:text-med-400 hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.1)] transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.15" data-lift-distance="4" aria-label="Appeler le cabinet">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="font-mono">07 62 36 73 37</span>
        </a>

        <!-- WhatsApp CTA -->
        <a href="https://wa.me/212762367337?text=Bonjour%20Dr%20OUMAKHIR%2C%20je%20souhaite%20prendre%20rendez-vous" target="_blank" rel="noopener noreferrer" class="btn-whatsapp hidden sm:flex magnetic ripple hover-lift" data-magnetic-strength="0.25" data-lift-distance="4" aria-label="Prendre rendez-vous sur WhatsApp">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-.424-.056 10.19 10.19 0 00-.467-.044 11.55 11.55 0 01-1.176-.265C.894 19.531 0 18.823 0 17.58V6.75C0 4.136 2.128 2 4.75 2c1.116 0 2.144.272 3.03.774C9.096 3.33 10.404 4 11.5 4c1.666 0 3.066-.933 3.75-2.252a.75.75 0 01.752-.432c1.333 0 2.62.547 3.458 1.582A8.09 8.09 0 0123 6.75v10.83c0 1.254-.896 2.382-2.196 2.834-.67.23-1.356.398-1.95.424a.75.75 0 01-.583-.105 7.54 7.54 0 01-1.58-.467 7.25 7.25 0 01-.578-.207z" />
          </svg>
          <span>Rendez-vous</span>
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2.5 rounded-xl glass-strong text-pearl-600 dark:text-pearl-400 hover:text-pearl-950 dark:hover:text-white hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.15)] transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.2" data-lift-distance="4" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu" style="color: var(--text-secondary);">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="lg:hidden hidden border-t border-white/20 dark:border-white/10 bg-white/95 dark:bg-pearl-950/95 backdrop-blur-2xl animate-slide-up" role="navigation" aria-label="Menu mobile">
      <div class="section-container py-4 space-y-2">
        <a href="#services" class="nav-link-mobile block px-4 py-3 text-base font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">Nos Services</a>
        <a href="#about" class="nav-link-mobile block px-4 py-3 text-base font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">Le Cabinet</a>
        <a href="#reviews" class="nav-link-mobile block px-4 py-3 text-base font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">Avis Patients</a>
        <a href="#faq" class="nav-link-mobile block px-4 py-3 text-base font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">FAQ</a>
        <a href="#contact" class="nav-link-mobile block px-4 py-3 text-base font-medium text-pearl-600 dark:text-pearl-400 rounded-xl transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">Contact</a>
        <div class="pt-4 space-y-3 border-t border-white/20 dark:border-white/10">
          <a href="tel:+212762367337" class="flex items-center justify-center gap-2 px-4 py-3 text-base font-medium text-pearl-700 dark:text-pearl-300 glass-strong rounded-xl hover:text-med-600 dark:hover:text-med-400 hover:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.1)] transition-all duration-300 magnetic hover-lift" data-magnetic-strength="0.1" data-lift-distance="2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span class="font-mono">07 62 36 73 37</span>
          </a>
          <a href="https://wa.me/212762367337" target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full justify-center magnetic ripple hover-lift" data-magnetic-strength="0.2" data-lift-distance="4" aria-label="Prendre rendez-vous sur WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-.424-.056 10.19 10.19 0 00-.467-.044 11.55 11.55 0 01-1.176-.265C.894 19.531 0 18.823 0 17.58V6.75C0 4.136 2.128 2 4.75 2c1.116 0 2.144.272 3.03.774C9.096 3.33 10.404 4 11.5 4c1.666 0 3.066-.933 3.75-2.252a.75.75 0 01.752-.432c1.333 0 2.62.547 3.458 1.582A8.09 8.09 0 0123 6.75v10.83c0 1.254-.896 2.382-2.196 2.834-.67.23-1.356.398-1.95.424a.75.75 0 01-.583-.105 7.54 7.54 0 01-1.58-.467 7.25 7.25 0 01-.578-.207z" />
            </svg>
            <span>Prendre rendez-vous</span>
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>

<script is:inline>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('hidden');
    menuBtn.setAttribute('aria-expanded', (!isOpen).toString());

    if (typeof window !== 'undefined' && window.gsap) {
      const gsap = window.gsap;
      gsap.fromTo(mobileMenu,
        { opacity: 0, y: -20 },
        { opacity: 1, y: 0, duration: 0.4, ease: 'expo.out' }
      );
    }

    menuBtn.innerHTML = isOpen
      ? '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>'
      : '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
  });

  // Close mobile menu when clicking a link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
      if (menuBtn) {
        menuBtn.innerHTML = '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>';
      }
    });
  });

  // Header scroll effect with GSAP
  const header = document.getElementById('main-header');
  let lastScroll = 0;
  let ticking = false;

  function updateHeader() {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      header?.classList.add('shadow-[0_10px_40px_-10px_rgba(0,0,0,0.1)]');
      header?.classList.add('bg-white/90');
      header?.classList.add('dark:bg-pearl-950/90');
    } else {
      header?.classList.remove('shadow-[0_10px_40px_-10px_rgba(0,0,0,0.1)]');
      header?.classList.remove('bg-white/90');
      header?.classList.remove('dark:bg-pearl-950/90');
    }

    // Hide/show on scroll direction
    if (currentScroll > lastScroll && currentScroll > 200) {
      header?.classList.add('-translate-y-full');
    } else {
      header?.classList.remove('-translate-y-full');
    }

    lastScroll = currentScroll;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateHeader);
      ticking = true;
    }
  }, { passive: true });

  // Active nav link highlighting
  const navLinks = document.querySelectorAll('.nav-link');
  const sections = ['services', 'about', 'reviews', 'faq', 'contact'];

  function updateActiveLink() {
    const scrollPos = window.scrollY + 200;

    sections.forEach(sectionId => {
      const section = document.getElementById(sectionId);
      const link = document.querySelector(`.nav-link[href="#${sectionId}"]`);

      if (section && link) {
        const sectionTop = section.offsetTop;
        const sectionHeight = section.offsetHeight;

        if (scrollPos >= sectionTop && scrollPos < sectionTop + sectionHeight) {
          navLinks.forEach(l => l.classList.remove('text-cyan-600', 'dark:text-cyan-400', 'font-semibold'));
          link.classList.add('text-cyan-600', 'dark:text-cyan-400', 'font-semibold');
        }
      }
    });
  }

  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
</script>

<style>
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-slide-up {
    animation: slide-up 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Header transition */
  header {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease, background-color 0.3s ease;
  }

  /* Nav link hover effect */
  .nav-link:hover {
    color: var(--text-primary);
  }
  .dark .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 2px;
    border-radius: 9999px;
    background: linear-gradient(90deg, #06b6d4, #a855f7);
    transition: all 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  /* Active nav link */
  .nav-link.text-cyan-600::after {
    width: 100%;
  }

  /* Mobile nav link */
  .nav-link-mobile:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }
  .dark .nav-link-mobile:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .animate-slide-up,
    header {
      animation: none !important;
      transition: none !important;
    }
  }
</style>