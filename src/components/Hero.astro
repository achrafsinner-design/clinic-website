---
interface Props {}
---

<section class="relative min-h-screen flex items-center justify-center pt-16 lg:pt-20 overflow-hidden" aria-labelledby="hero-title">
  <!-- Aurora background glow -->
  <div class="absolute inset-0 -z-10 aurora-bg" aria-hidden="true"></div>

  <!-- Noise texture overlay -->
  <div class="absolute inset-0 -z-10 noise opacity-[0.02]" aria-hidden="true"></div>

  <!-- Scan lines for futuristic feel -->
  <div class="absolute inset-0 -z-10 scan-lines pointer-events-none" aria-hidden="true"></div>

  <!-- Floating gradient blobs -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-med-100/50 dark:bg-med-900/20 rounded-full blur-3xl opacity-60 float-slow" aria-hidden="true"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-teal-100/50 dark:bg-teal-900/20 rounded-full blur-3xl opacity-60 float" style="animation-delay: 1s" aria-hidden="true"></div>
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-rose-100/50 dark:bg-rose-900/20 rounded-full blur-3xl opacity-40 float-3d" aria-hidden="true"></div>

  <div class="section-container py-20 lg:py-32 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Content -->
      <div class="reveal up stagger-1 duration-normal ease-spring">
        <!-- Badge with live indicator -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/50 dark:bg-white/10 backdrop-blur-xl border border-white/20 dark:border-white/10 text-med-700 dark:text-med-300 text-sm font-medium mb-6 magnetic" data-magnetic-strength="0.2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-med-400/75 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-med-500"></span>
          </span>
          <span>Nouveau : Réservation en ligne disponible</span>
          <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>

        <!-- Main headline with gradient text -->
        <h1 id="hero-title" class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-pearl-950 dark:text-white leading-tight text-balance mb-6 reveal-text ease-spring">
          Votre peau
          <span class="text-gradient-med"> mérite</span>
          <br />
          <span class="text-gradient-cyan"> l'excellence</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-pearl-600 dark:text-pearl-400 leading-relaxed max-w-xl mb-8 reveal up stagger-2 duration-normal ease-spring">
          Cabinet de dermatologie et médecine esthétique à Marrakech. Dr Siham OUMAKHIR vous accompagne avec expertise, bienveillance et technologies de pointe pour la santé et la beauté de votre peau.
        </p>

        <!-- Trust indicators with animated counters -->
        <div class="flex flex-wrap items-center gap-6 mb-8 reveal up stagger-3 duration-normal ease-spring">
          <div class="flex items-center gap-2 text-pearl-600 dark:text-pearl-400 magnetic" data-magnetic-strength="0.15">
            <svg class="w-5 h-5 text-med-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-mono font-bold text-2xl counter" data-target="4.7" data-decimals="1" data-suffix="/5">4.7/5</span>
            <span class="text-pearl-400 dark:text-pearl-500 text-sm">(165 avis)</span>
          </div>
          <div class="flex items-center gap-2 text-pearl-600 dark:text-pearl-400 magnetic" data-magnetic-strength="0.15">
            <svg class="w-5 h-5 text-teal-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-mono font-bold text-2xl counter" data-target="15" data-suffix="+">15+</span>
            <span class="text-pearl-400 dark:text-pearl-500 text-sm">ans d'expérience</span>
          </div>
          <div class="flex items-center gap-2 text-pearl-600 dark:text-pearl-400 magnetic" data-magnetic-strength="0.15">
            <svg class="w-5 h-5 text-rose-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium">Technologies</span>
            <span class="text-pearl-400 dark:text-pearl-500 text-sm">de pointe</span>
          </div>
        </div>

        <!-- CTA Buttons with magnetic effect -->
        <div class="flex flex-col sm:flex-row gap-4 reveal up stagger-4 duration-normal ease-spring">
          <a href="https://wa.me/212762367337?text=Bonjour%20Dr%20OUMAKHIR%2C%20je%20souhaite%20prendre%20rendez-vous" target="_blank" rel="noopener noreferrer" class="btn-whatsapp w-full sm:w-auto justify-center group magnetic relative overflow-hidden" data-magnetic-strength="0.25" aria-label="Prendre rendez-vous sur WhatsApp">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-.424-.056 10.19 10.19 0 00-.467-.044 11.55 11.55 0 01-1.176-.265C.894 19.531 0 18.823 0 17.58V6.75C0 4.136 2.128 2 4.75 2c1.116 0 2.144.272 3.03.774C9.096 3.33 10.404 4 11.5 4c1.666 0 3.066-.933 3.75-2.252a.75.75 0 01.752-.432c1.333 0 2.62.547 3.458 1.582A8.09 8.09 0 0123 6.75v10.83c0 1.254-.896 2.382-2.196 2.834-.67.23-1.356.398-1.95.424a.75.75 0 01-.583-.105 7.54 7.54 0 01-1.58-.467 7.25 7.25 0 01-.578-.207z" />
            </svg>
            <span data-magnetic-child="0.1">Prendre rendez-vous</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
            <!-- Ripple effect -->
            <span class="absolute inset-0" aria-hidden="true"></span>
          </a>
          <a href="#contact" class="btn-secondary w-full sm:w-auto justify-center group magnetic" data-magnetic-strength="0.2" aria-label="Appeler le cabinet">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span data-magnetic-child="0.1">Appeler maintenant</span>
          </a>
        </div>

        <!-- Scroll indicator with animation -->
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 reveal up stagger-5 duration-slow ease-bounce" aria-hidden="true">
          <div class="flex flex-col items-center gap-2">
            <div class="w-10 h-10 rounded-full border border-white/30 dark:border-white/10 flex items-center justify-center animate-bounce-slow magnetic" data-magnetic-strength="0.1">
              <svg class="w-5 h-5 text-pearl-400 dark:text-pearl-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
            <span class="text-xs text-pearl-400 dark:text-pearl-500 font-medium uppercase tracking-wider">Découvrir</span>
          </div>
        </div>
      </div>

      <!-- Right: Doctor Card with 3D effects -->
      <div class="relative reveal right stagger-2 duration-slow ease-spring">
        <div class="relative">
          <!-- Main image with 3D tilt effect -->
          <div class="aspect-[4/5] w-full max-w-md mx-auto lg:mx-0 rounded-3xl overflow-hidden shadow-[0_50px_100px_-20px_rgba(0,0,0,0.2)] relative group tilt-card hover-lift" data-tilt-max="10" data-lift-distance="12">
            <img
              src="/images/team/team-1.png"
              alt="Dr Siham OUMAKHIR - Dermatologue à Marrakech"
              class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
              loading="eager"
              fetchpriority="high"
            />

            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-pearl-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700" aria-hidden="true"></div>

            <!-- Floating badges with 3D orbit -->
            <div class="absolute -top-4 -right-4 hidden lg:block reveal scale stagger-1 duration-normal ease-bounce orbit-slow">
              <div class="glass-strong p-4 transform rotate-3 transition-all duration-500 hover:rotate-0 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.2)] hover:scale-105 magnetic" data-magnetic-strength="0.15">
                <div class="flex items-center gap-2 text-med-600 dark:text-med-400">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <span class="font-semibold text-lg counter" data-target="4.7" data-decimals="1">4.7</span>
                </div>
                <p class="text-sm text-pearl-600 dark:text-pearl-400 mt-1">/5 • 165 avis Google</p>
              </div>
            </div>

            <div class="absolute -bottom-6 -left-6 hidden lg:block reveal scale stagger-2 duration-normal ease-bounce orbit-slow" style="animation-delay: 1s">
              <div class="glass-strong p-4 transform -rotate-3 transition-all duration-500 hover:rotate-0 hover:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.2)] hover:scale-105 magnetic" data-magnetic-strength="0.15">
                <div class="flex items-center gap-2 text-teal-600 dark:text-teal-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span class="font-semibold">Ouvert</span>
                </div>
                <p class="text-sm text-pearl-600 dark:text-pearl-400 mt-1">Lun-Ven 9h-19h</p>
              </div>
            </div>

            <!-- Floating certification badge -->
            <div class="absolute top-4 left-4 hidden lg:block reveal scale stagger-3 duration-normal ease-bounce" style="animation-delay: 0.5s">
              <div class="glass-strong px-4 py-2 rounded-full transition-all duration-500 hover:scale-105 magnetic" data-magnetic-strength="0.1">
                <div class="flex items-center gap-2 text-cyan-600 dark:text-cyan-400">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <span class="font-semibold text-sm">Certifié</span>
                </div>
              </div>
            </div>

            <!-- Doctor info overlay on hover -->
            <div class="absolute bottom-0 left-0 right-0 p-6 transform translate-y-full opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-700 ease-out bg-gradient-to-t from-pearl-900/95 via-pearl-900/50 to-transparent">
              <div class="text-center text-white">
                <h3 class="text-xl font-bold mb-1 font-display">Dr Siham OUMAKHIR</h3>
                <p class="text-med-300 font-medium mb-2">Dermatologue - Médecine Esthétique</p>
                <p class="text-pearl-300 text-sm max-w-xs mx-auto">Expertise médicale • Écoute • Résultats naturels</p>
                <div class="flex items-center justify-center gap-4 mt-4 pt-4 border-t border-white/20">
                  <a href="https://wa.me/212762367337" target="_blank" rel="noopener noreferrer" class="text-pearl-300 hover:text-white transition-colors" aria-label="WhatsApp">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.454.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-.424-.056 10.19 10.19 0 00-.467-.044 11.55 11.55 0 01-1.176-.265C.894 19.531 0 18.823 0 17.58V6.75C0 4.136 2.128 2 4.75 2c1.116 0 2.144.272 3.03.774C9.096 3.33 10.404 4 11.5 4c1.666 0 3.066-.933 3.75-2.252a.75.75 0 01.752-.432c1.333 0 2.62.547 3.458 1.582A8.09 8.09 0 0123 6.75v10.83c0 1.254-.896 2.382-2.196 2.834-.67.23-1.356.398-1.95.424a.75.75 0 01-.583-.105 7.54 7.54 0 01-1.58-.467 7.25 7.25 0 01-.578-.207z"/></svg>
                  </a>
                  <a href="tel:+212762367337" class="text-pearl-300 hover:text-white transition-colors" aria-label="Appeler">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Decorative floating elements with 3D motion -->
          <div class="absolute -top-4 -right-4 w-32 h-32 bg-med-200/40 dark:bg-med-900/20 rounded-full blur-2xl float-3d" aria-hidden="true"></div>
          <div class="absolute -bottom-8 -left-8 w-24 h-24 bg-teal-200/40 dark:bg-teal-900/20 rounded-full blur-2xl float-3d" style="animation-delay: 2s" aria-hidden="true"></div>
          <div class="absolute top-1/2 -right-12 w-16 h-16 bg-rose-200/30 dark:bg-rose-900/20 rounded-full blur-2xl float-3d" style="animation-delay: 1s" aria-hidden="true"></div>

          <!-- Geometric accent shapes -->
          <div class="absolute top-20 left-10 hidden lg:block" aria-hidden="true">
            <div class="w-8 h-8 border-2 border-cyan-500/50 dark:border-cyan-400/50 rounded-lg rotate-45 float-slow opacity-50"></div>
          </div>
          <div class="absolute bottom-20 right-10 hidden lg:block" aria-hidden="true">
            <div class="w-6 h-6 bg-violet-500/30 rounded-full float-fast"></div>
          </div>
          <div class="absolute top-1/2 left-0 hidden lg:block" aria-hidden="true">
            <div class="w-4 h-4 border-2 border-rose-500/50 dark:border-rose-400/50 rounded rotate-12 float-slow opacity-50" style="animation-delay: 1.5s"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Animated shape divider -->
  <div class="absolute bottom-0 left-0 right-0 h-32 -z-10 overflow-hidden" aria-hidden="true">
    <svg class="w-full h-full" viewBox="0 0 1440 100" preserveAspectRatio="none">
      <path class="text-white dark:text-pearl-950" d="M0,0 C360,80 1080,80 1440,0 L1440,100 L0,100 Z" />
    </svg>
  </div>
</section>

<style>
  /* Custom animations for hero */
  @keyframes bounce-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .animate-bounce-slow {
    animation: bounce-slow 3s ease-in-out infinite;
  }

  @keyframes orbit-slow {
    from { transform: rotate(0deg) translateX(20px) rotate(0deg); }
    to { transform: rotate(360deg) translateX(20px) rotate(-360deg); }
  }

  .orbit-slow {
    animation: orbit-slow 20s linear infinite;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .animate-bounce-slow,
    .orbit-slow,
    .float-3d {
      animation: none !important;
    }
  }
</style>