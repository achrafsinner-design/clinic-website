          </div>

          <!-- Divider -->
          <div class="hidden md:block w-px h-32 bg-gradient-to-b from-transparent via-white/30 to-transparent"></div>
          <div class="md:hidden w-32 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

          <!-- Keywords -->
          <div class="grid grid-cols-3 gap-4 text-center">
            <div class="card-interactive p-4 hover-lift magnetic" data-magnetic-strength="0.1" data-lift-distance="4">
              <div class="text-4xl font-bold font-mono text-cyan-600 dark:text-cyan-400 counter" data-target="13">13</div>
              <div class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">« Humaine »</div>
            </div>
            <div class="card-interactive p-4 hover-lift magnetic" data-magnetic-strength="0.1" data-lift-distance="4" style="animation-delay: 0.1s">
              <div class="text-4xl font-bold font-mono text-violet-600 dark:text-violet-400 counter" data-target="12">12</div>
              <div class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">« Compétente »</div>
            </div>
            <div class="card-interactive p-4 hover-lift magnetic" data-magnetic-strength="0.1" data-lift-distance="4" style="animation-delay: 0.2s">
              <div class="text-4xl font-bold font-mono text-rose-600 dark:text-rose-400 counter" data-target="8">8</div>
              <div class="text-xs text-pearl-500 dark:text-pearl-400 mt-1">« Bienveillance »</div>
            </div>
          </div>
        </div>
      </div>
