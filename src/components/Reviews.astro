---
interface Props {}
---

<section id="reviews" class="py-20 lg:py-32 relative overflow-hidden" aria-labelledby="reviews-title">
  <!-- Aurora glow -->
  <div class="absolute inset-0 -z-10 aurora-bg opacity-60" aria-hidden="true"></div>

  <!-- Noise texture -->
  <div class="absolute inset-0 -z-10 noise opacity-[0.015]" aria-hidden="true"></div>

  <div class="section-container relative z-10">
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 reveal up stagger-1 duration-normal ease-spring">
      <span class="section-label magnetic" data-magnetic-strength="0.1">Témoignages</span>
      <h2 id="reviews-title" class="section-title font-display reveal-text">
        La parole à nos
        <br class="hidden sm:block" />
        <span class="text-gradient">patients</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Plus de 165 avis sur Google avec une note de 4,7/5. Découvrez ce que nos patients pensent de leur expérience.
      </p>
    </div>

    <!-- Rating Summary with Animated Counters -->
    <div class="max-w-4xl mx-auto mb-16 reveal up stagger-2 duration-slow ease-spring">
      <div class="card-interactive p-8 md:p-12 text-center group hover-lift magnetic perspective-reveal" data-magnetic-strength="0.1" data-lift-distance="8">
        <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 via-violet-500/10 to-rose-500/10 rounded-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500" aria-hidden="true"></div>

        <div class="relative flex flex-col md:flex-row items-center justify-center gap-8 md:gap-16">
          <!-- Main Rating -->
          <div class="flex flex-col items-center">
            <div class="text-7xl md:text-9xl font-bold font-mono text-gradient counter" data-target="4.7" data-decimals="1">4,7</div>
            <div class="flex items-center justify-center gap-1 mt-3">
              <svg class="w-7 h-7 text-amber-400 fill-current" viewBox="0 0 20 20" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
