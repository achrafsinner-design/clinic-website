<script is:inline>
  // Advanced Reviews Carousel with GSAP
  const track = document.getElementById('reviews-track');
  const prevBtn = document.getElementById('prev-review');
  const nextBtn = document.getElementById('next-review');
  const dotsContainer = document.getElementById('review-dots');

  if (track && prevBtn && nextBtn && dotsContainer) {
    const cards = track.querySelectorAll('[data-review]');
    const cardWidth = 384 + 24; // sm:w-96 = 384px + gap-6 = 24px
    let currentIndex = 0;
    const maxIndex = cards.length - 1;
    let isAnimating = false;

    // Create dots
    cards.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 ${i === 0 ? 'bg-cyan-500 scale-125' : 'bg-pearl-300 dark:bg-pearl-600'}`;
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', `Aller à l'avis ${i + 1}`);
      dot.addEventListener('click', () => goToSlide(i));
      dotsContainer.appendChild(dot);
    });

    const dots = dotsContainer.querySelectorAll('button');

    function updateCarousel() {
      if (typeof window !== 'undefined' && window.gsap) {
        const gsap = window.gsap;

        // Animate track
        gsap.to(track, {
          x: -currentIndex * cardWidth,
          duration: 0.8,
          ease: 'expo.out',
          onComplete: () => { isAnimating = false; }
        });

        // Animate cards
        cards.forEach((card, i) => {
          const isActive = i === currentIndex;
          gsap.to(card, {
            scale: isActive ? 1.02 : 1,
            zIndex: isActive ? 10 : 1,
            duration: 0.5,
            ease: 'expo.out'
          });
        });
      } else {
        track.style.transform = `translateX(${-currentIndex * cardWidth}px)`;
      }

      // Update dots
      dots.forEach((dot, i) => {
        const isActive = i === currentIndex;
        dot.classList.toggle('bg-cyan-500', isActive);
        dot.classList.toggle('scale-125', isActive);
        dot.classList.toggle('bg-pearl-300', !isActive);
        dot.classList.toggle('dark:bg-pearl-600', !isActive);
      });

      // Update buttons
      prevBtn.disabled = currentIndex === 0 || isAnimating;
      nextBtn.disabled = currentIndex === maxIndex || isAnimating;
      prevBtn.classList.toggle('opacity-40', currentIndex === 0);
      nextBtn.classList.toggle('opacity-40', currentIndex === maxIndex);
      prevBtn.classList.toggle('pointer-events-none', currentIndex === 0);
      nextBtn.classList.toggle('pointer-events-none', currentIndex === maxIndex);
    }

    function goToSlide(index) {
      if (isAnimating) return;
      isAnimating = true;
      currentIndex = Math.max(0, Math.min(index, maxIndex));
      updateCarousel();
    }

    prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
    nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));

    // Keyboard navigation
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') goToSlide(currentIndex - 1);
      if (e.key === 'ArrowRight') goToSlide(currentIndex + 1);
    });

    // Touch swipe support
    let touchStartX = 0;
    track.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        goToSlide(currentIndex + (diff > 0 ? 1 : -1));
      }
    }, { passive: true });

    // Auto-play
    let autoPlayInterval: number;
    function startAutoPlay() {
      autoPlayInterval = window.setInterval(() => {
        if (!isAnimating) {
          goToSlide(currentIndex === maxIndex ? 0 : currentIndex + 1);
        }
      }, 5000);
    }
    function stopAutoPlay() {
      clearInterval(autoPlayInterval);
    }

    track.addEventListener('mouseenter', stopAutoPlay);
    track.addEventListener('mouseleave', startAutoPlay);
    track.addEventListener('touchstart', stopAutoPlay, { passive: true });

    startAutoPlay();
    updateCarousel();
  }
</script>