---
interface Props {
  variant?: 'hero' | 'services' | 'about' | 'contact' | 'mesh' | 'particles' | 'waves' | 'dna' | 'neural';
  class?: string;
  id?: string;
}

const { variant = 'hero', class: className = '', id } = Astro.props;
---

<div class={`webgl-canvas ${className}`} id={id} data-variant={variant} aria-hidden="true"></div>

<script is:inline>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

  const container = document.currentScript?.parentElement?.querySelector('.webgl-canvas') || document.querySelector(`[data-variant="${variant}"]`);
  if (!container) return;

  // Scene setup
  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
  const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true, powerPreference: 'high-performance' });
  renderer.setSize(window.innerWidth, window.innerHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);
  container.appendChild(renderer.domElement);

  let animationId: number;
  let time = 0;
  const isDark = document.documentElement.classList.contains('dark');

  // Color themes per variant
  const themes = {
    hero: { primary: 0x06b6d4, secondary: 0xa855f7, accent: 0xf43f5e },
    services: { primary: 0x16a34a, secondary: 0x06b6d4, accent: 0xa855f7 },
    about: { primary: 0x0d9488, secondary: 0x9333ea, accent: 0xe11d48 },
    contact: { primary: 0x0891b2, secondary: 0x7e22ce, accent: 0xbe123c },
    mesh: { primary: 0x06b6d4, secondary: 0xa855f7, accent: 0xf43f5e },
    particles: { primary: 0x22d3ee, secondary: 0xc084fc, accent: 0xfb7185 },
    waves: { primary: 0x06b6d4, secondary: 0x0d9488, accent: 0x14b8a6 },
    dna: { primary: 0xf43f5e, secondary: 0xa855f7, accent: 0x06b6d4 },
    neural: { primary: 0x06b6d4, secondary: 0xa855f7, accent: 0x22d3ee }
  };

  const theme = themes[variant as keyof typeof themes] || themes.hero;

  // Convert hex to THREE.Color
  const primaryColor = new THREE.Color(theme.primary);
  const secondaryColor = new THREE.Color(theme.secondary);
  const accentColor = new THREE.Color(theme.accent);

  // Mouse tracking for interactivity
  const mouse = new THREE.Vector2(0, 0);
  const targetMouse = new THREE.Vector2(0, 0);

  document.addEventListener('mousemove', (e) => {
    targetMouse.x = (e.clientX / window.innerWidth) * 2 - 1;
    targetMouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  document.addEventListener('touchmove', (e) => {
    if (e.touches[0]) {
      targetMouse.x = (e.touches[0].clientX / window.innerWidth) * 2 - 1;
      targetMouse.y = -(e.touches[0].clientY / window.innerHeight) * 2 + 1;
    }
  }, { passive: true });

  // Variant implementations
  let geometry: THREE.BufferGeometry;
  let material: THREE.Material;
  let mesh: THREE.Mesh | THREE.Points | THREE.LineSegments;
  const particles: THREE.Points[] = [];
  const lines: THREE.Line[] = [];

  function createHeroVariant() {
    // Floating geometric shapes with morphing
    const shapes = [
      new THREE.IcosahedronGeometry(1, 1),
      new THREE.OctahedronGeometry(1, 1),
      new THREE.TetrahedronGeometry(1, 1),
      new THREE.DodecahedronGeometry(1, 1)
    ];

    const group = new THREE.Group();

    shapes.forEach((geo, i) => {
      const mat = new THREE.MeshPhysicalMaterial({
        color: [primaryColor, secondaryColor, accentColor, primaryColor][i],
        metalness: 0.3,
        roughness: 0.4,
        transmission: 0.3,
        thickness: 0.5,
        transparent: true,
        opacity: 0.15,
        side: THREE.DoubleSide,
        clearcoat: 0.5,
        clearcoatRoughness: 0.1
      });

      const m = new THREE.Mesh(geo, mat);
      m.position.set(
        (Math.random() - 0.5) * 6,
        (Math.random() - 0.5) * 6,
        (Math.random() - 0.5) * 6
      );
      m.rotation.set(Math.random() * Math.PI, Math.random() * Math.PI, 0);
      m.scale.setScalar(0.5 + Math.random() * 0.8);
      m.userData = {
        basePosition: m.position.clone(),
        baseRotation: m.rotation.clone(),
        speed: 0.3 + Math.random() * 0.5,
        axis: new THREE.Vector3(
          Math.random() - 0.5,
          Math.random() - 0.5,
          Math.random() - 0.5
        ).normalize()
      };
      group.add(m);
    });

    // Add particle field
    const particleGeo = new THREE.BufferGeometry();
    const particleCount = 800;
    const positions = new Float32Array(particleCount * 3);
    const sizes = new Float32Array(particleCount);
    const colors = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount; i++) {
      const radius = 5 + Math.random() * 10;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
      positions[i * 3 + 2] = radius * Math.cos(phi);

      sizes[i] = Math.random() * 2 + 0.5;

      const color = new THREE.Color().lerpColors(
        primaryColor,
        secondaryColor,
        Math.random()
      );
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;
    }

    particleGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    particleGeo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
    particleGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

    const particleMat = new THREE.PointsMaterial({
      size: 1,
      vertexColors: true,
      transparent: true,
      opacity: 0.6,
      sizeAttenuation: true,
      blending: THREE.AdditiveBlending
    });

    const particleSystem = new THREE.Points(particleGeo, particleMat);
    group.add(particleSystem);
    particles.push(particleSystem);

    scene.add(group);
    mesh = group as unknown as THREE.Mesh;

    camera.position.z = 15;
  }

  function createMeshVariant() {
    // Wireframe mesh grid with wave distortion
    const gridSize = 50;
    const gridDivisions = 50;
    geometry = new THREE.PlaneGeometry(gridSize, gridSize, gridDivisions, gridDivisions);

    material = new THREE.MeshBasicMaterial({
      color: primaryColor,
      wireframe: true,
      transparent: true,
      opacity: 0.15,
      side: THREE.DoubleSide
    });

    mesh = new THREE.Mesh(geometry, material);
    mesh.rotation.x = -Math.PI / 2;
    mesh.position.y = -2;

    scene.add(mesh);
    camera.position.set(0, 10, 15);
    camera.lookAt(0, 0, 0);
  }

  function createParticlesVariant() {
    // Volumetric particle cloud
    const particleCount = 3000;
    geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);
    const velocities = new Float32Array(particleCount * 3);
    const sizes = new Float32Array(particleCount);
    const colors = new Float32Array(particleCount * 3);
    const alphas = new Float32Array(particleCount);

    for (let i = 0; i < particleCount; i++) {
      const radius = Math.random() * 8;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);

      positions[i * 3] = radius * Math.sin(phi) * Math.cos(theta);
      positions[i * 3 + 1] = radius * Math.sin(phi) * Math.sin(theta);
      positions[i * 3 + 2] = radius * Math.cos(phi);

      velocities[i * 3] = (Math.random() - 0.5) * 0.01;
      velocities[i * 3 + 1] = (Math.random() - 0.5) * 0.01;
      velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.01;

      sizes[i] = Math.random() * 3 + 0.5;

      const t = Math.random();
      const color = new THREE.Color().lerpColors(
        primaryColor,
        t > 0.5 ? secondaryColor : accentColor,
        t
      );
      colors[i * 3] = color.r;
      colors[i * 3 + 1] = color.g;
      colors[i * 3 + 2] = color.b;

      alphas[i] = Math.random() * 0.5 + 0.2;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    geometry.setAttribute('velocity', new THREE.BufferAttribute(velocities, 3));
    geometry.setAttribute('size', new THREE.BufferAttribute(sizes, 1));
    geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
    geometry.setAttribute('alpha', new THREE.BufferAttribute(alphas, 1));

    material = new THREE.PointsMaterial({
      size: 1,
      vertexColors: true,
      transparent: true,
      opacity: 1,
      sizeAttenuation: true,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    mesh = new THREE.Points(geometry, material);
    scene.add(mesh);
    camera.position.z = 20;
  }

  function createWavesVariant() {
    // Multiple wave layers
    const waveCount = 5;
    const group = new THREE.Group();

    for (let w = 0; w < waveCount; w++) {
      const geo = new THREE.PlaneGeometry(60, 60, 100, 100);
      const mat = new THREE.MeshPhysicalMaterial({
        color: new THREE.Color().lerpColors(primaryColor, secondaryColor, w / waveCount),
        metalness: 0.1,
        roughness: 0.8,
        transmission: 0.5,
        thickness: 0.5,
        transparent: true,
        opacity: 0.08,
        side: THREE.DoubleSide,
        wireframe: w % 2 === 0
      });

      const wave = new THREE.Mesh(geo, mat);
      wave.rotation.x = -Math.PI / 2;
      wave.position.y = w * 0.5 - 1;
      wave.userData = {
        waveIndex: w,
        speed: 0.5 + w * 0.2,
        amplitude: 0.3 + w * 0.1,
        frequency: 0.5 + w * 0.3
      };
      group.add(wave);
      lines.push(wave);
    }

    scene.add(group);
    mesh = group as unknown as THREE.Mesh;
    camera.position.set(0, 15, 20);
    camera.lookAt(0, 0, 0);
  }

  function createDNAVariant() {
    // DNA double helix structure
    const group = new THREE.Group();
    const helixRadius = 2;
    const helixHeight = 15;
    const turns = 3;
    const pointsPerTurn = 30;
    const totalPoints = turns * pointsPerTurn;

    // Create two helices
    for (let helix = 0; helix < 2; helix++) {
      const curve = new THREE.CatmullRomCurve3([]);
      const points: THREE.Vector3[] = [];

      for (let i = 0; i <= totalPoints; i++) {
        const t = i / totalPoints;
        const angle = t * turns * Math.PI * 2 + (helix * Math.PI);
        const y = t * helixHeight - helixHeight / 2;

        points.push(new THREE.Vector3(
          Math.cos(angle) * helixRadius,
          y,
          Math.sin(angle) * helixRadius
        ));
      }

      curve.points = points;

      const tubeGeo = new THREE.TubeGeometry(curve, totalPoints * 2, 0.15, 8, false);
      const tubeMat = new THREE.MeshPhysicalMaterial({
        color: helix === 0 ? primaryColor : secondaryColor,
        metalness: 0.4,
        roughness: 0.3,
        transmission: 0.2,
        clearcoat: 1,
        clearcoatRoughness: 0,
        transparent: true,
        opacity: 0.7
      });

      const tube = new THREE.Mesh(tubeGeo, tubeMat);
      group.add(tube);
      lines.push(tube);
    }

    // Connecting rungs
    const rungGeo = new THREE.CylinderGeometry(0.05, 0.05, helixRadius * 2, 4);
    const rungMat = new THREE.MeshBasicMaterial({
      color: accentColor,
      transparent: true,
      opacity: 0.5
    });

    for (let i = 0; i <= totalPoints; i += 3) {
      const t = i / totalPoints;
      const angle = t * turns * Math.PI * 2;
      const y = t * helixHeight - helixHeight / 2;

      const rung = new THREE.Mesh(rungGeo, rungMat);
      rung.position.set(0, y, 0);
      rung.rotation.z = angle + Math.PI / 2;
      group.add(rung);
    }

    scene.add(group);
    mesh = group as unknown as THREE.Mesh;
    camera.position.set(0, 0, 12);
  }

  function createNeuralVariant() {
    // Neural network visualization
    const nodeCount = 80;
    const connectionDistance = 4;
    const group = new THREE.Group();

    const nodes: THREE.Mesh[] = [];
    const positions = new Float32Array(nodeCount * 3);

    // Create nodes
    const nodeGeo = new THREE.SphereGeometry(0.08, 16, 16);
    for (let i = 0; i < nodeCount; i++) {
      const pos = new THREE.Vector3(
        (Math.random() - 0.5) * 20,
        (Math.random() - 0.5) * 15,
        (Math.random() - 0.5) * 20
      );

      positions[i * 3] = pos.x;
      positions[i * 3 + 1] = pos.y;
      positions[i * 3 + 2] = pos.z;

      const hue = 0.5 + Math.random() * 0.3; // cyan to violet
      const color = new THREE.Color().setHSL(hue, 0.8, 0.6);

      const mat = new THREE.MeshBasicMaterial({
        color,
        transparent: true,
        opacity: 0.8,
        blending: THREE.AdditiveBlending,
        depthWrite: false
      });

      const node = new THREE.Mesh(nodeGeo, mat);
      node.position.copy(pos);
      node.userData = {
        basePos: pos.clone(),
        phase: Math.random() * Math.PI * 2,
        speed: 0.5 + Math.random() * 0.5,
        connections: [] as number[]
      };
      nodes.push(node);
      group.add(node);
    }

    // Find connections
    for (let i = 0; i < nodeCount; i++) {
      for (let j = i + 1; j < nodeCount; j++) {
        const dist = nodes[i].position.distanceTo(nodes[j].position);
        if (dist < connectionDistance && Math.random() < 0.3) {
          nodes[i].userData.connections.push(j);
          nodes[j].userData.connections.push(i);
        }
      }
    }

    // Create connection lines
    const lineGeo = new THREE.BufferGeometry();
    const linePositions: number[] = [];
    const lineColors: number[] = [];

    for (let i = 0; i < nodeCount; i++) {
      const node = nodes[i];
      node.userData.connections.forEach((j: number) => {
        if (i < j) { // Avoid duplicates
          linePositions.push(
            node.position.x, node.position.y, node.position.z,
            nodes[j].position.x, nodes[j].position.y, nodes[j].position.z
          );

          const color = new THREE.Color().lerpColors(
            (node.material as THREE.MeshBasicMaterial).color as THREE.Color,
            (nodes[j].material as THREE.MeshBasicMaterial).color as THREE.Color,
            0.5
          );
          lineColors.push(color.r, color.g, color.b, color.r, color.g, color.b);
        }
      });
    }

    lineGeo.setAttribute('position', new THREE.Float32BufferAttribute(linePositions, 3));
    lineGeo.setAttribute('color', new THREE.Float32BufferAttribute(lineColors, 3));

    const lineMat = new THREE.LineBasicMaterial({
      vertexColors: true,
      transparent: true,
      opacity: 0.3,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });

    const lineMesh = new THREE.LineSegments(lineGeo, lineMat);
    group.add(lineMesh);
    lines.push(lineMesh);

    scene.add(group);
    mesh = group as unknown as THREE.Mesh;
    camera.position.z = 25;
  }

  // Initialize variant
  const variantCreators: Record<string, () => void> = {
    hero: createHeroVariant,
    mesh: createMeshVariant,
    particles: createParticlesVariant,
    waves: createWavesVariant,
    dna: createDNAVariant,
    neural: createNeuralVariant,
    services: createParticlesVariant,
    about: createWavesVariant,
    contact: createNeuralVariant
  };

  (variantCreators[variant] || createHeroVariant)();

  // Post-processing setup
  const composer = new THREE.EffectComposer(renderer);
  const renderPass = new THREE.RenderPass(scene, camera);
  composer.addPass(renderPass);

  // Bloom pass for glow
  const bloomPass = new THREE.UnrealBloomPass(
    new THREE.Vector2(window.innerWidth, window.innerHeight),
    0.3, 0.5, 0.85
  );
  bloomPass.threshold = 0.5;
  bloomPass.strength = 0.4;
  bloomPass.radius = 0.6;
  composer.addPass(bloomPass);

  // Animation loop
  function animate() {
    animationId = requestAnimationFrame(animate);
    time += 0.01;

    // Smooth mouse follow
    mouse.x += (targetMouse.x - mouse.x) * 0.05;
    mouse.y += (targetMouse.y - mouse.y) * 0.05;

    // Update based on variant
    switch (variant) {
      case 'hero':
        if (mesh && mesh instanceof THREE.Group) {
          mesh.children.forEach((child, i) => {
            if (child instanceof THREE.Mesh && child.userData.basePosition) {
              const ud = child.userData;
              child.position.x = ud.basePosition.x + Math.sin(time * ud.speed + i) * 1.5;
              child.position.y = ud.basePosition.y + Math.cos(time * ud.speed * 0.7 + i) * 1.5;
              child.position.z = ud.basePosition.z + Math.sin(time * ud.speed * 1.3 + i) * 1.5;
              child.rotation.x += 0.002 * ud.speed;
              child.rotation.y += 0.003 * ud.speed;

              // Mouse influence
              child.position.x += mouse.x * 0.5;
              child.position.y += mouse.y * 0.5;
            } else if (child instanceof THREE.Points) {
              child.rotation.y += 0.0002;
              child.rotation.x += 0.0001;
            }
          });

          // Rotate entire group slowly
          mesh.rotation.y += 0.0003;
        }
        break;

      case 'mesh':
      case 'services':
        if (mesh && mesh.geometry) {
          const positions = mesh.geometry.attributes.position.array as Float32Array;
          for (let i = 0; i < positions.length; i += 3) {
            const x = positions[i];
            const z = positions[i + 2];
            positions[i + 1] = Math.sin(x * 0.5 + time) * Math.cos(z * 0.5 + time) * 0.8;
          }
          mesh.geometry.attributes.position.needsUpdate = true;
          mesh.geometry.computeVertexNormals();
        }
        if (mesh) mesh.rotation.y += 0.0001;
        break;

      case 'particles':
        if (mesh && mesh.geometry) {
          const positions = mesh.geometry.attributes.position.array as Float32Array;
          const velocities = mesh.geometry.attributes.velocity.array as Float32Array;

          for (let i = 0; i < positions.length; i += 3) {
            positions[i] += velocities[i];
            positions[i + 1] += velocities[i + 1];
            positions[i + 2] += velocities[i + 2];

            // Boundary wrap
            const dist = Math.sqrt(positions[i] ** 2 + positions[i + 1] ** 2 + positions[i + 2] ** 2);
            if (dist > 15) {
              positions[i] *= 0.95;
              positions[i + 1] *= 0.95;
              positions[i + 2] *= 0.95;
            }

            // Mouse attraction
            const mouseForce = 0.0001;
            positions[i] += mouse.x * mouseForce;
            positions[i + 1] += mouse.y * mouseForce;
          }
          mesh.geometry.attributes.position.needsUpdate = true;
          mesh.rotation.y += 0.0002;
        }
        break;

      case 'waves':
      case 'about':
        if (mesh && mesh instanceof THREE.Group) {
          mesh.children.forEach((child, i) => {
            if (child instanceof THREE.Mesh && child.geometry) {
              const ud = child.userData;
              const positions = child.geometry.attributes.position.array as Float32Array;

              for (let j = 0; j < positions.length; j += 3) {
                const x = positions[j];
                const z = positions[j + 2];
                positions[j + 1] = Math.sin(x * ud.frequency + time * ud.speed) *
                                 Math.cos(z * ud.frequency + time * ud.speed) *
                                 ud.amplitude;
              }
              child.geometry.attributes.position.needsUpdate = true;
              child.geometry.computeVertexNormals();
            }
          });
        }
        break;

      case 'dna':
        if (mesh && mesh instanceof THREE.Group) {
          mesh.rotation.y += 0.002;
          mesh.rotation.x = Math.sin(time * 0.3) * 0.2;
        }
        break;

      case 'neural':
      case 'contact':
        if (mesh && mesh instanceof THREE.Group) {
          mesh.children.forEach((child) => {
            if (child instanceof THREE.Mesh && child.userData.basePos) {
              const ud = child.userData;
              child.position.x = ud.basePos.x + Math.sin(time * ud.speed + ud.phase) * 0.5;
              child.position.y = ud.basePos.y + Math.cos(time * ud.speed * 0.7 + ud.phase) * 0.5;
              child.position.z = ud.basePos.z + Math.sin(time * ud.speed * 1.2 + ud.phase) * 0.5;

              // Pulse scale
              const pulse = 1 + Math.sin(time * 3 + ud.phase) * 0.2;
              child.scale.setScalar(pulse);
            } else if (child instanceof THREE.LineSegments) {
              child.rotation.y += 0.0003;
            }
          });
          mesh.rotation.y += 0.0001;
        }
        break;
    }

    // Camera subtle movement
    camera.position.x += (mouse.x * 2 - camera.position.x) * 0.01;
    camera.position.y += (-mouse.y * 2 - camera.position.y) * 0.01;
    camera.lookAt(0, 0, 0);

    composer.render();
  }

  // Handle resize
  function onResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    composer.setSize(window.innerWidth, window.innerHeight);
  }
  window.addEventListener('resize', onResize);

  // Theme change listener
  const observer = new MutationObserver(() => {
    const newDark = document.documentElement.classList.contains('dark');
    if (newDark !== isDark) {
      location.reload(); // Simple reload for theme change - could be optimized
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // Start animation
  animate();

  // Cleanup
  return () => {
    cancelAnimationFrame(animationId);
    window.removeEventListener('resize', onResize);
    observer.disconnect();
    renderer.dispose();
    composer.passes.forEach(pass => {
      if (pass instanceof THREE.RenderPass) return;
      if (typeof (pass as any).dispose === 'function') (pass as any).dispose();
    });
  };
</script>

<!-- Import Three.js addons for post-processing -->
<script type="importmap">
{
  "imports": {
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.165.0/examples/jsm/"
  }
}
</script>